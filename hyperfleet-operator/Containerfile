FROM registry.access.redhat.com/ubi9/go-toolset:1.26.7-1787774815 AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64

USER 0
RUN mkdir -p /workspace && chown 1001:0 /workspace
USER 1001

WORKDIR /workspace
ENV GOCACHE=/workspace/.cache/go-build

COPY hyperfleet-db/go.mod hyperfleet-db/go.sum ./hyperfleet-db/
COPY api/go.mod api/go.sum ./api/
COPY hyperfleet-operator/go.mod hyperfleet-operator/go.sum ./hyperfleet-operator/
RUN cd hyperfleet-operator && go mod download

COPY api/ ./api/
COPY hyperfleet-db/ ./hyperfleet-db/
COPY hyperfleet-operator/ ./hyperfleet-operator/

RUN cd hyperfleet-operator && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -a -o /workspace/manager ./cmd/manager
RUN cd hyperfleet-operator && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -a -o /workspace/compactor ./cmd/compactor

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1787647261

ARG VERSION=0.0.1
ARG RELEASE=1

LABEL name="rosa-hyperfleet-operator" \
      vendor="Red Hat, Inc." \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="ROSA Hyperfleet operator" \
      description="ROSA Hyperfleet operator (manager + compactor)" \
      io.k8s.display-name="rosa-hyperfleet-operator" \
      io.k8s.description="ROSA Hyperfleet operator (manager + compactor)" \
      com.redhat.component="rosa-hyperfleet-operator-container" \
      distribution-scope="public" \
      url="https://github.com/openshift-online/rosa-hyperfleet-api"

WORKDIR /app

COPY --from=builder /workspace/manager /app/manager
COPY --from=builder /workspace/compactor /app/compactor

USER 65534:65534

ENTRYPOINT ["/app/manager"]
