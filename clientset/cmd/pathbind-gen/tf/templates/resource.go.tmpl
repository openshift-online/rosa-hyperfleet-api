// This is used before pathbind.Expand to prepare input for API calls.
func terraform{{.ResourceName}}ToNative(tf *{{.ResourceName}}State) (*{{.ResourceName}}StateNative, diag.Diagnostics) {
	if tf == nil {
		return nil, nil
	}
	native := &{{.ResourceName}}StateNative{}
	var diags diag.Diagnostics
{{- range .TopFields}}
{{- if eq .Type "list(object)"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		encoded, collectionDiags := terraformObjectListToJSON(tf.{{.GoName}})
		diags = append(diags, collectionDiags...)
