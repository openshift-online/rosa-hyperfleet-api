	}
{{- else if hasSuffix .Type "[]"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		items, collectionDiags := terraformListToStringSlice(tf.{{.GoName}})
		diags = append(diags, collectionDiags...)
		native.{{.GoName}} = items
	}
{{- else if eq .Type "string"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		native.{{.GoName}} = tf.{{.GoName}}.ValueString()
	}
{{- else if eq .Type "*string"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		s := tf.{{.GoName}}.ValueString()
		native.{{.GoName}} = &s
	}
{{- else if eq .Type "bool"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		native.{{.GoName}} = tf.{{.GoName}}.ValueBool()
	}
{{- else if eq .Type "*bool"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		b := tf.{{.GoName}}.ValueBool()
		native.{{.GoName}} = &b
	}
{{- else if eq .Type "int32"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		value := tf.{{.GoName}}.ValueInt64()
		if value < math.MinInt32 || value > math.MaxInt32 {
			diags.AddError("Invalid int32 value", fmt.Sprintf("field {{.GoName}} value %d is outside the int32 range", value))
		} else {
			native.{{.GoName}} = int32(value)
		}
	}
{{- else if eq .Type "*int32"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		value := tf.{{.GoName}}.ValueInt64()
		if value < math.MinInt32 || value > math.MaxInt32 {
			diags.AddError("Invalid int32 value", fmt.Sprintf("field {{.GoName}} value %d is outside the int32 range", value))
		} else {
			i := int32(value)
			native.{{.GoName}} = &i
		}
	}
{{- else if eq .Type "int64"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		native.{{.GoName}} = tf.{{.GoName}}.ValueInt64()
	}
{{- else if eq .Type "*int64"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		i := tf.{{.GoName}}.ValueInt64()
		native.{{.GoName}} = &i
	}
{{- else if eq .Type "map"}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		values, collectionDiags := terraformMapToStringMap(tf.{{.GoName}})
		diags = append(diags, collectionDiags...)
		native.{{.GoName}} = values
	}
{{- else}}
	if !tf.{{.GoName}}.IsNull() && !tf.{{.GoName}}.IsUnknown() {
		native.{{.GoName}} = tf.{{.GoName}}.ValueString()
	}
{{- end}}
{{- end}}
{{- range .Bundles}}
	{{- $bundle := .}}
	if !tf.{{$bundle.GoName}}.IsNull() && !tf.{{$bundle.GoName}}.IsUnknown() {
		bundleDiags := objectToNative(tf.{{$bundle.GoName}}, &native.{{$bundle.GoName}}, map[string]string{
{{- range $bundle.Fields}}
			"{{attrName .}}": "{{.GoName}}",
{{- end}}
		})
		diags = append(diags, bundleDiags...)
	}
{{- end}}
	return native, diags
}

// native{{.ResourceName}}ToTerraform converts native Go types to Terraform framework types.
// This is used after pathbind.Flatten to prepare output for state persistence.
func native{{.ResourceName}}ToTerraform(native *{{.ResourceName}}StateNative) (*{{.ResourceName}}State, diag.Diagnostics) {
	if native == nil {
		return nil, nil
	}
	tf := &{{.ResourceName}}State{}
var diags diag.Diagnostics
{{- range .TopFields}}
{{- if eq .Type "list(object)"}}
	{
		var collectionDiags diag.Diagnostics
		tf.{{.GoName}}, collectionDiags = terraformJSONToObjectList(native.{{.GoName}}, map[string]attr.Type{
{{- range .ElementAttributes}}
			"{{.Name}}": {{objectAttrType .}},
{{- end}}
		})
		diags = append(diags, collectionDiags...)
	}
{{- else if hasSuffix .Type "[]"}}
	tf.{{.GoName}} = toTerraformList(native.{{.GoName}})
{{- else if eq .Type "string"}}
	tf.{{.GoName}} = toTerraformString(native.{{.GoName}})
{{- else if eq .Type "*string"}}
	tf.{{.GoName}} = toTerraformString(stringPtrValue(native.{{.GoName}}))
{{- else if eq .Type "bool"}}
	tf.{{.GoName}} = toTerraformBool(native.{{.GoName}})
{{- else if eq .Type "*bool"}}
	tf.{{.GoName}} = toTerraformBoolPtr(native.{{.GoName}})
{{- else if eq .Type "int32"}}
	tf.{{.GoName}} = toTerraformInt64(int64(native.{{.GoName}}))
{{- else if eq .Type "*int32"}}
	{{- if and (not .Computed) (not .Required)}}
	tf.{{.GoName}} = toTerraformInt64Ptr(normalizeOptionalInt32ToInt64(native.{{.GoName}}))
	{{- else}}
	tf.{{.GoName}} = toTerraformInt64Ptr(int64Ptr(int32Ptr(native.{{.GoName}})))
	{{- end}}
{{- else if eq .Type "int64"}}
	tf.{{.GoName}} = toTerraformInt64(native.{{.GoName}})
{{- else if eq .Type "*int64"}}
	{{- if and (not .Computed) (not .Required)}}
	tf.{{.GoName}} = toTerraformInt64Ptr(normalizeOptionalInt64(native.{{.GoName}}))
	{{- else}}
	tf.{{.GoName}} = toTerraformInt64Ptr(native.{{.GoName}})
	{{- end}}
{{- else if eq .Type "map"}}
	tf.{{.GoName}} = toTerraformMap(native.{{.GoName}})
{{- else}}
	tf.{{.GoName}} = toTerraformString(native.{{.GoName}})
{{- end}}
{{- end}}
{{- range .Bundles}}
	{
		bundleAttrs := nativeBundleAttributes(native.{{.GoName}}, map[string]string{
{{- range .Fields}}
			"{{attrName .}}": "{{.GoName}}",
{{- end}}
		})
		tf.{{.GoName}}, _ = types.ObjectValue(map[string]attr.Type{
{{- range .Fields}}
			"{{attrName .}}": {{if hasSuffix .Type "[]"}}types.ListType{ElemType: types.StringType}{{else if eq .Type "map"}}types.MapType{ElemType: types.StringType}{{else if or (eq .Type "bool") (eq .Type "*bool")}}types.BoolType{{else if or (eq .Type "int32") (eq .Type "*int32") (eq .Type "int64") (eq .Type "*int64")}}types.Int64Type{{else}}types.StringType{{end}},
{{- end}}
		}, bundleAttrs)
	}
{{- end}}
	return tf, diags
}
