{
  "formatVersion": 1,
  "registeredAccounts": ["111111111111", "222222222222"],
  "policies": [
    {
      "id": "list",
      "ownerAccountID": "111111111111",
      "content": "permit(principal, action == HyperFleet::Action::\"ListClusters\", resource is HyperFleet::Collection);"
    },
    {
      "id": "blue",
      "ownerAccountID": "111111111111",
      "content": "permit(principal, action == HyperFleet::Action::\"DescribeCluster\", resource is HyperFleet::Cluster) when { resource.hasTag(\"example.com/team\") && resource.getTag(\"example.com/team\") == \"blue\" };"
    },
    {
      "id": "read",
      "ownerAccountID": "111111111111",
      "content": "permit(principal, action in HyperFleet::Action::\"ReadOnly\", resource);"
    },
    {
      "id": "runtime-fault",
      "ownerAccountID": "111111111111",
      "content": "forbid(principal, action == HyperFleet::Action::\"DescribeCluster\", resource) when { resource.hasTag(\"example.com/fault\") && resource.getTag(\"example.com/fault\") == \"fault-detail-secret\" && 9223372036854775807 + 1 == 0 };"
    },
    {
      "id": "describe",
      "ownerAccountID": "111111111111",
      "content": "permit(principal, action == HyperFleet::Action::\"DescribeCluster\", resource is HyperFleet::Cluster);"
    },
    {
      "id": "forbid",
      "ownerAccountID": "111111111111",
      "content": "forbid(principal, action in HyperFleet::Action::\"ReadOnly\", resource);"
    },
    {
      "id": "unregistered-read",
      "ownerAccountID": "333333333333",
      "content": "permit(principal, action in HyperFleet::Action::\"ReadOnly\", resource);"
    },
    {"id":"lifecycle", "ownerAccountID":"111111111111", "content":"permit(principal, action in HyperFleet::Action::\"AllActions\", resource);"},
    {"id":"base-update", "ownerAccountID":"111111111111", "content":"permit(principal, action in [HyperFleet::Action::\"UpdateCluster\", HyperFleet::Action::\"UpdateNodePool\"], resource);"},
    {"id":"special-update", "ownerAccountID":"111111111111", "content":"permit(principal, action in [HyperFleet::Action::\"ScaleNodePool\", HyperFleet::Action::\"UpdateClusterVersion\", HyperFleet::Action::\"UpdateNodePoolVersion\"], resource);"},
    {"id":"wildcard", "ownerAccountID":"111111111111", "content":"permit(principal, action, resource);"},
    {"id":"resource-list", "ownerAccountID":"111111111111", "content":"permit(principal, action in [HyperFleet::Action::\"ListNodePools\", HyperFleet::Action::\"ListOIDCConfigs\"], resource);"},
    {"id":"resource-blue", "ownerAccountID":"111111111111", "content":"permit(principal, action in [HyperFleet::Action::\"DescribeNodePool\", HyperFleet::Action::\"DescribeOIDCConfig\"], resource) when { resource.hasTag(\"example.com/team\") && resource.getTag(\"example.com/team\") == \"blue\" };"},
    {"id":"resource-error", "ownerAccountID":"111111111111", "content":"forbid(principal, action in [HyperFleet::Action::\"DescribeNodePool\", HyperFleet::Action::\"DescribeOIDCConfig\"], resource) when { resource.hasTag(\"example.com/fault\") && 9223372036854775807 + 1 == 0 };"},
    {"id":"context", "ownerAccountID":"111111111111", "content":"permit(principal, action == HyperFleet::Action::\"DescribeCluster\", resource) when { context.sourceIp == \"192.0.2.50\" && context.userAgent == \"local-authz-http\" && context.requestTime.unixSeconds > 0 && context.requestTime.dayOfWeek >= 1 && context.requestTime.dayOfWeek <= 7 && context.requestTime.hour >= 0 && context.requestTime.hour <= 23 };"}
  ],
  "attachments": [
    {"id":"a-list", "policyID":"list", "principalARN":"arn:aws:iam::111111111111:user/alice", "scope":"global"},
    {"id":"a-blue", "policyID":"blue", "principalARN":"arn:aws:iam::111111111111:user/alice", "scope":"global"},
    {"id":"list-only", "policyID":"list", "principalARN":"arn:aws:iam::111111111111:user/list-only", "scope":"global"},
