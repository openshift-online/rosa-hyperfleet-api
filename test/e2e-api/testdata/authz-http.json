    {"id":"special-update", "policyID":"special-update", "principalARN":"arn:aws:iam::111111111111:user/special-updater", "scope":"global"},
    {"id":"wildcard", "policyID":"wildcard", "principalARN":"arn:aws:iam::111111111111:user/wildcard", "scope":"global"},
    {"id":"resource-list-only", "policyID":"resource-list", "principalARN":"arn:aws:iam::111111111111:user/resource-list-only", "scope":"global"},
    {"id":"resource-describe-only", "policyID":"resource-blue", "principalARN":"arn:aws:iam::111111111111:user/resource-describe-only", "scope":"global"},
    {"id":"resource-scoped-list", "policyID":"resource-list", "principalARN":"arn:aws:iam::111111111111:user/resource-scoped", "scope":"global"},
    {"id":"resource-scoped-blue", "policyID":"resource-blue", "principalARN":"arn:aws:iam::111111111111:user/resource-scoped", "scope":"global"},
    {"id":"resource-error-read", "policyID":"read", "principalARN":"arn:aws:iam::111111111111:user/resource-error", "scope":"global"},
    {"id":"resource-error-forbid", "policyID":"resource-error", "principalARN":"arn:aws:iam::111111111111:user/resource-error", "scope":"global"},
    {"id":"context", "policyID":"context", "principalARN":"arn:aws:iam::111111111111:user/context", "scope":"global"}
  ],
  "serviceOperatorPolicies": [
    {"id":"operator", "ownerAccountID":"111111111111", "content":"permit(principal, action in HyperFleet::Action::\"ServiceOperator\", resource);"},
    {"id":"operator-list", "ownerAccountID":"111111111111", "content":"permit(principal, action == HyperFleet::Action::\"ListManagementClusters\", resource);"},
    {"id":"operator-blue", "ownerAccountID":"111111111111", "content":"permit(principal, action == HyperFleet::Action::\"DescribeManagementCluster\", resource) when { resource.hasTag(\"example.com/team\") && resource.getTag(\"example.com/team\") == \"blue\" };"},
    {"id":"operator-error", "ownerAccountID":"111111111111", "content":"forbid(principal, action == HyperFleet::Action::\"DescribeManagementCluster\", resource) when { resource.hasTag(\"example.com/fault\") && 9223372036854775807 + 1 == 0 };"}
  ],
